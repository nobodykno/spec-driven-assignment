{
  "name": "spec-driven-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter auth dev\" \"pnpm --filter tracker dev\" \"pnpm --filter api-gateway dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm check:versions && pnpm check:file-names && pnpm check:claude-settings && pnpm check:agents && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "test": "pnpm -r test && vitest run scripts/ .claude/hooks/",
    "check:versions": "node scripts/check-versions.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @app/database migrate",
    "db:migrate:undo": "pnpm --filter @app/database migrate:undo",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "check:file-names": "node scripts/check-file-names.mjs",
    "check:claude-settings": "node scripts/check-claude-settings.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:workflow": "node scripts/check-workflow.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
