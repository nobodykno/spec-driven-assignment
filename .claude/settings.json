{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s localhost*)",
      "Bash(curl -s * http://localhost*)",
      "Bash(curl -s * localhost*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose start:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(git merge main:*)",
      "Bash(git worktree:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm --filter * add:*)",
      "Bash(pnpm --filter=* add:*)",
      "Bash(pnpm -F * add:*)",
      "Bash(pnpm -w add:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm up:*)",
      "Bash(pnpm update:*)",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__addCommentToJiraIssue",
      "mcp__atlassian__addWorklogToJiraIssue",
      "mcp__atlassian__createIssueLink"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(docker compose down -v:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.mjs\""
          }
        ]
      }
    ]
  }
}
